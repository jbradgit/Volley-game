# Normalise line endings: text files stored as LF, checked out per-platform.
# (Dev happens on Windows + ephemeral Linux containers — see HANDOVER §2.)
* text=auto

# Explicit binaries — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.swf binary
*.wasm binary
*.blend binary
*.zip binary
*.woff binary
*.woff2 binary
