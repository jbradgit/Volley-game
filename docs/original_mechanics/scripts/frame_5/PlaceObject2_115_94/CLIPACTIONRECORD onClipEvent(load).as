onClipEvent(load){
   function kick()
   {
      if(!_level0.kicked and !_level0.paused)
      {
         _level0.man.gotoandplay("kick");
         _level0.kicked = true;
         eve += 1000;
      }
   }
   eve = 0;
   if(_level0.ve < 5)
   {
      _level0.cityarewank = "cityarwank";
   }
}
