# Local scratch tooling — never tracked (JRE, ffdec, snapshot scripts, screenshots)
tools/

# Build/distribution archives
scordagol_web.zip
game.zip

# Python cache (anywhere in the tree)
__pycache__/
*.pyc

# 3D sprite pipeline: large Mixamo source clips (re-downloadable; see docs/ART_SOURCING.md)
artgen/source3d/

# Blender auto-save backups (the .blend itself is tracked as pipeline source)
*.blend1

# artgen debug/scratch scaffolding (previews, picker sheets, throwaway scripts)
artgen/_*

# Temp and log files
*.tmp
*.log
server.*.log

# Node deps (reinstalled per session; puppeteer-core for the layout-audit skill)
node_modules/

# Slick Vic trace SOURCE — large, local-only (the traced assets/ui/slick_vic.png is what ships)
assets/ui/New Vic.png
